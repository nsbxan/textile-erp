# Textile ERP Server Environment Variables
PORT=5000

# ==========================================
# EMAIL YUBORISH (SMTP - Gmail yoki boshqa pochta)
# ==========================================
# Haqiqiy Gmail pochtangizdan xodimlar va foydalanuvchilar emailiga
# maxfiy kod yuborish uchun Google hisobingizdan "App Password" (16 belgili) oling:
# 1. Google hisobingizga kiring: https://myaccount.google.com/security
# 2. "2-Step Verification" (2 bosqichli tekshirish) ni yoqing.
# 3. "App Passwords" bo'limiga kirib yangi parol yarating (masalan: "Textile ERP").
# 4. Chiqqan 16 belgili parolni pastdagi SMTP_PASS ga yozing:

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="Textile ERP Tizimi"
